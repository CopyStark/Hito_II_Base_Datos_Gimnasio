# =====================================================================
# GimnasioDB - Configuración de Variables de Entorno (Backend)
# =====================================================================

# Servidor y Credenciales de Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GimnasioDB
DB_USER=sa
DB_PASSWORD=TuPasswordSeguro123!

# Driver ODBC (Asegúrate de tener instalado "ODBC Driver 17 for SQL Server")
DB_DRIVER=ODBC Driver 17 for SQL Server

# Autenticación de Windows (yes/no). Si es 'yes', ignora DB_USER y DB_PASSWORD
DB_TRUSTED_CONNECTION=no

# Configuración de cifrado y certificados (recomendado para desarrollo local)
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Servidor FastAPI
HOST=0.0.0.0
PORT=8000

# CORS (Frontend Next.js)
ALLOWED_ORIGINS=http://localhost:3000
